[Unit]
Description=Gunicorn Daemon for Ops Monitor Flask App
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=/opt/Python_Practice_Script/Server_Tool/ops_monitor
ExecStart=/opt/Python_Practice_Script/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target